# Local VAmPI lab secrets and transient data
roles_config.json
# API keys stay session-only environment variables; never write them to project files.
.env
.env.*
*.key
# Private reviewed ZAP Context exports and local non-secret attestations.
zap/*.context
zap/imported-context-attestation.json
zap/private/
zap/run-output/
.bfla-runs/

# Generated authorization-lab reports may contain lab response data
results/

# Web MVP secrets, SQLite data, and frontend build/runtime files
data/
frontend/node_modules/
frontend/dist/

# Python runtime and package-build files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# A local frontend preview can create a SQLite runtime copy; never version it.
frontend/data/

# Downloaded third-party source checkout; retain locally as untrusted reference only.
VAmPI-source/

# Claude session runtime state is machine-specific and must not be versioned.
.claude/scheduled_tasks.lock
